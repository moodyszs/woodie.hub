    end

    local function requestAmmoRefill(tool, ammo)
        if LoadoutRemote == nil
            or refillActive
            or tool == nil
            or ammo == nil
            or ammo:GetAttribute("ZeeKillRefillRequested")
        then
            return false
        end

        local character = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")

        if backpack == nil then
            return false
        end

        ammo:SetAttribute("ZeeKillRefillRequested", true)
        refillActive = true

        local requestedName = tool.Name
        local oldTools = {}
        local equippedTools = {}
        local newestTools = {}
        local seenTools = {}

        for _, container in ipairs({ backpack, character }) do
            if container then
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool") and Guns[item.Name] then
                        oldTools[item] = true

                        if item.Parent == character then
                            equippedTools[item.Name] = true
                        end
                    end
                end
            end
        end

        local connections = {}
        local heartbeat
        local stopped = false
        local deadline = os.clock() + 2
        local lastAdded = os.clock()

        local function stop()
            if stopped then
                return
            end

            stopped = true

            for _, connection in ipairs(connections) do
                connection:Disconnect()
            end

            if heartbeat then
                heartbeat:Disconnect()
            end

            if not newestTools[requestedName] and ammo.Parent then
                ammo:SetAttribute("ZeeKillRefillRequested", nil)
            end

            refillActive = false
        end
local function accept(item)
            if not item:IsA("Tool")
                or not Guns[item.Name]
                or oldTools[item]
                or seenTools[item]
            then
                return
            end

            seenTools[item] = true
            lastAdded = os.clock()

            local name = item.Name
            local previous = newestTools[name]

            if previous and previous ~= item and previous.Parent then
                previous:Destroy()
            end

            newestTools[name] = item

            for oldTool in pairs(oldTools) do
                if oldTool.Name == name and oldTool.Parent then
                    oldTool:Destroy()
                end
            end

            if equippedTools[name] and character and item.Parent then
                item.Parent = character
            end
        end

        connections[1] = backpack.ChildAdded:Connect(accept)

        if character then
            connections[2] = character.ChildAdded:Connect(accept)
        end

        LoadoutRemote:FireServer(Loadout)

        return true
    end

    local function usableAmmo(tool, ammo)
        if ammo.Value <= 0 then
            requestAmmoRefill(tool, ammo)
            return false
        end

        if not ammo:GetAttribute("ZeeKillAmmoWatching") then
            ammo:SetAttribute("ZeeKillAmmoWatching", true)

            local connection

            connection = ammo:GetPropertyChangedSignal("Value"):Connect(function()
                if ammo.Value <= 0 then
                    connection:Disconnect()
                    requestAmmoRefill(tool, ammo)
                end
            end)
        end

        return true
    end

