_AS_foundRemotes = nil
_AS_lastStompTime = 0
_AS_lastKnockedTarget = nil

_AS_stompKeywords = {
    "STOMP", "Stomp", "stomp",
    "FinishOff", "finish", "FINISH"
}

_AS_remoteNamesToFind = {
    "MAINEVENT", "MainEvent", "MainRemoteEvent",
    "RemoteEvent", "MainRemote", "MainGameEvent",
    "GameEvent", "Communication", "Stomp", "STOMP"
}

function _AS_findStompRemotes()
    if _AS_foundRemotes and #_AS_foundRemotes > 0 then
        return _AS_foundRemotes
    end

    _AS_remotes = {}
    _AS_seen = {}

    function _AS_addRemote(remote)
        if not remote then return end
        if _AS_seen[remote] then return end
        if not (remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") or remote:IsA("RemoteFunction")) then return end
        _AS_seen[remote] = true
        table.insert(_AS_remotes, remote)
    end

    for _, _AS_name in ipairs(_AS_remoteNamesToFind) do
        _AS_addRemote(_55:FindFirstChild(_AS_name))
    end

    _AS_pathsToCheck = {
        {"MainRemotes", "MainRemoteEvent"},
        {"MainRemotes", "MainEvent"},
        {"Remotes", "MainRemoteEvent"},
        {"Remotes", "MainEvent"},
        {"Remotes", "STOMP"},
        {"Remotes", "Stomp"},
        {"Events", "MainEvent"},
        {"Events", "Stomp"},
        {"Game", "MainEvent"},
        {"Game", "RemoteEvent"},
        {"Game", "Stomp"},
        {"Communication", "MainEvent"},
        {"Core", "MainEvent"}
    }

    for _, _AS_path in ipairs(_AS_pathsToCheck) do
        _AS_current = _55
        for _, _AS_segment in ipairs(_AS_path) do
            _AS_current = _AS_current and _AS_current:FindFirstChild(_AS_segment)
        end
        _AS_addRemote(_AS_current)
    end

    pcall(function()
        for _, _AS_child in ipairs(_55:GetDescendants()) do
            if #_AS_remotes >= 20 then break end
            if _AS_child:IsA("RemoteEvent") or _AS_child:IsA("UnreliableRemoteEvent") then
                _AS_nameLower = string.lower(_AS_child.Name)
                if string.find(_AS_nameLower, "stomp", 1, true) or
                   string.find(_AS_nameLower, "main", 1, true) or
                   string.find(_AS_nameLower, "finish", 1, true) then
                    _AS_addRemote(_AS_child)
                end
            end
        end
    end)

    _AS_foundRemotes = _AS_remotes
    return _AS_remotes
end

function _AS_fireStompRemotes(targetPlayer)
    _AS_remotes = _AS_findStompRemotes()

    for _, _AS_remote in ipairs(_AS_remotes) do
        for _, _AS_keyword in ipairs(_AS_stompKeywords) do
            pcall(function() _AS_remote:FireServer(_AS_keyword) end)
            if targetPlayer then
                pcall(function() _AS_remote:FireServer(_AS_keyword, targetPlayer) end)
            end
        end
    end
end

