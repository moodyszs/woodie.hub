            -- Restore script-level void hide if it was active before the buy
            if voidWasActive then
                _118 = true
                if _121 then pcall(function() _121:Disconnect() end) end
                _121 = _52.Heartbeat:Connect(function()
                    if _118 and _120 then
                        local _t = tick()
                        _120.CFrame = CFrame.new(
                            math.floor((_t * 4423) % 999999991) * math.sign(math.sin(_t * 7919)),
                            math.floor((_t * 6287) % 999999973) * math.sign(math.cos(_t * 6421)),
                            math.floor((_t * 3499) % 999999937) * math.sign(math.sin(_t * 8737))
                        ) * CFrame.Angles((_t * 17) % (math.pi * 2), (_t * 31) % (math.pi * 2), (_t * 53) % (math.pi * 2))
                    end
                end)
            end

            if aborted then
                _buyLockUntil = tick() + 0.45
                if countStims() > 0 and _hum and _hum.Health > 5 then
                    local pct = (_hum.MaxHealth > 0) and ((_hum.Health / _hum.MaxHealth) * 100) or 0
                    if pct <= cfg.lowHealthThreshold then
                        task.defer(useStim)
                    end
                end
                return countStims() > before
            end

            if countStims() > before then
                _failStreak = 0
                _buyLockUntil = tick() + 0.3
                return true
            end

            _failStreak = _failStreak + 1
            _buyLockUntil = tick() + math.min(0.7 + _failStreak * 0.3, 2.5)
            return okBuy and false
        end

        local function manageStims()
            if not stimEnabled or _isRespawning or isDead() or _buying or _using then
                return
            end
            refreshChar()
            if not _hum or _hum.MaxHealth <= 0 then
                return
            end
            local need = stockTarget()
            local cur = countStims()
            local pct = (_hum.Health / _hum.MaxHealth) * 100

            if pct <= cfg.lowHealthThreshold and _hum.Health > 5 and cur > 0 then
                useStim()
                return
            end

            if cur < need then
                if inCombat() and cur > 0 then
                    return
                end
                buyStims(false)
            end
        end

        -- Events
        local function bindHum(hum)
            if not hum then return end
            _lastHp = hum.Health
            hum.HealthChanged:Connect(function(hp)
                if not _hum or _hum ~= hum then return end
                if _lastHp and hp < _lastHp - 0.5 then
                    _lastDamageAt = tick()
                    if _buying then
                        _abortBuy = true
                    end
                end
                _lastHp = hp

                if not stimEnabled or _isRespawning then return end
                if hum.MaxHealth <= 0 or hp <= 5 then return end
                local pct = (hp / hum.MaxHealth) * 100
                if pct > cfg.lowHealthThreshold then return end

                if countStims() > 0 then
                    if _buying then
                        _abortBuy = true
                    elseif not _using then
                        useStim()
                    end
                    return
                end

                if not _buying and tick() - _lastBuy >= (cfg.stimBuyCooldown or 0.55) then
                    task.defer(buyStims, false)
                end
            end)
        end

        pl.CharacterAdded:Connect(function(char)
            _isRespawning = true
            _abortBuy = true
            setCrouch(false)
            stopDesync()
            _char, _hum, _root = char, nil, nil
            _stimCount, _stimTool = -1, nil
            _buying, _using = false, false
            _lastHp = nil
            task.spawn(function()
                local hum = char:WaitForChild("Humanoid", 8)
                local root = char:WaitForChild("HumanoidRootPart", 8)
                _hum, _root, _char = hum, root, char
                _abortBuy = false
                bindHum(hum)
                task.wait(0.35)
                _isRespawning = false
                findStimShop(true)
                if stimEnabled then
                    task.delay(0.45, function()
                        if stimEnabled and not isDead() and not inCombat() and countStims() < stockTarget() then
                            buyStims(false)
                        end
                    end)
                end
            end)
        end)

        if pl.Character then
            refreshChar()
            bindHum(_hum)
        end

        -- Main loop
        task.spawn(function()
            local lastMaintain = 0
            while _alive do
                pcall(function()
                    local now = tick()
                    refreshChar()
                    if stimEnabled and not _isRespawning and not isDead() and not _buying
                        and now >= _buyLockUntil and not _SD_IsCombatBusy() then
                        if now - lastMaintain >= (cfg.maintainDelay or 0.85) then
                            lastMaintain = now
                            if _root and (not _shopPart or distXZ(_root.Position, _shopPart.Position) > 14) then
                                _safeHome = _root.CFrame
                            end
                            manageStims()
                        end
                    elseif not _buying and _desyncOn then
                        stopDesync()
                        setCrouch(false)
                    end
                end)
                task.wait(0.08)
            end
        end)

        findStimShop(true)
        print("[Stim Controller] Ready")

        return {
            cfg = cfg,
            setEnabled = setEnabled,
            setThreshold = function(v) cfg.lowHealthThreshold = v end,
            busy = function() return _buying or _using or _isRespawning end,
        }
    end)({
        autoStim = Toggles.AutoStim.Value,
        lowHealthThreshold = Options.AutoStimThreshold.Value,
    })

    -- Wire the existing UI to the stim controller
    local function _SyncStimController()
        if not _SC then return end
        local enabled = Toggles.AutoStim.Value == true
        if enabled and not Toggles.AutoStimVoidIgnore.Value and (_118 or _DS.active) then
            enabled = false
        end
        _SC.setEnabled(enabled)
    end

    Toggles.AutoStim:OnChanged(_SyncStimController)
    Options.AutoStimThreshold:OnChanged(function(v)
        if _SC then _SC.setThreshold(v) end
    end)
    Toggles.AutoStimVoidIgnore:OnChanged(_SyncStimController)

    -- Keep in sync when void-hide / desync state changes at runtime
    task.spawn(function()
        while true do
            task.wait(0.15)
            pcall(_SyncStimController)
        end
    end)

    _SyncStimController()

    -- Expose stim busy/state to the rest of the script (Kill All / Sentry coordinate with it)
    _SD_IsStimBusy = function()
        if not _SC then return false end
        return type(_SC.busy) == "function" and (_SC.busy()) or false
    end
end

