        local function waitStimCount(minCount, timeout)
            local t0 = tick()
            timeout = timeout or 0.85
            while tick() - t0 < timeout do
                if shouldAbortBuy() then break end
                _stimCount = -1
                if countStims() >= minCount then break end
                task.wait(0.03)
            end
            _stimCount = -1
            return countStims()
        end

        local function restoreHome(homeCF, savedVel)
            stopDesync()
            setCrouch(false)
            refreshChar()
            local live = _root
            if live and live.Parent and typeof(homeCF) == "CFrame" then
                pcall(function()
                    live.CFrame = homeCF
                    if typeof(savedVel) == "Vector3" then
