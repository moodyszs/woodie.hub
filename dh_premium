        local function isDowned(player)
            local char = player.Character
            if not char then
                local firedAt = FireTracker.FiredAt[player]
                if firedAt and os.clock() - firedAt < 1.2 then
                    return false
                end
                return true
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then
                return true
            end
            local be = char:FindFirstChild("BodyEffects")
            local ko = be and be:FindFirstChild("K.O")
            if ko and ko.Value == true then
                return true
            end
            return false
        end

        local AIM_HIT_RADIUS = 45
        local FIRE_WINDOW = 0.7
        local VOID_DIST = 120

        local function myRootPos()
            local char = LocalPlayer.Character
            local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
            return hrp and hrp.Position or nil
        end

        local function playerDist(player)
            local me = myRootPos()
            if not me then
                return 0
            end
            local char = player.Character
            if not char then
                return math.huge
            end
            local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
            if not hrp then
                return math.huge
            end
            return (hrp.Position - me).Magnitude
        end

        local function isVoidLike(player)
            return playerDist(player) >= VOID_DIST
        end

        local function mouseOnUs(player, myHead)
            if not myHead then
                return false
            end
            local mp = FireTracker.Mouse[player]
            if not mp or typeof(mp) ~= "Vector3" then
                return false
            end
            return (mp - myHead.Position).Magnitude <= AIM_HIT_RADIUS
        end

        local function recentFirers(window)
            local now = os.clock()
            window = window or FIRE_WINDOW
            local list = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and not isFriendlyWhitelisted(p) and not isDowned(p) then
                    local firedAt = FireTracker.FiredAt[p]
                    if firedAt and (now - firedAt) <= window then
                        list[#list + 1] = p
                    end
                end
            end
            return list
        end

        local function pickBestAttacker(candidates, myHead)
            if not candidates or #candidates == 0 then
                return nil, "none"
            end

            local aimed = {}
            for _, p in ipairs(candidates) do
                if mouseOnUs(p, myHead) then
                    aimed[#aimed + 1] = p
                end
            end

            local pool = aimed
            local why = "aim"
            if #pool == 0 then
                local voids = {}
                for _, p in ipairs(candidates) do
                    if isVoidLike(p) then
                        voids[#voids + 1] = p
                    end
                end
                if #voids == 1 then
                    return voids[1], "unique-void-firer"
                end
                return nil, "no-aim-on-us"
            end

            if #pool == 1 then
                return pool[1], isVoidLike(pool[1]) and "void-aim" or "near-aim"
            end

            local best, bestD = nil, -1
            for _, p in ipairs(pool) do
                local d = playerDist(p)
                if d > bestD then
                    best, bestD = p, d
                end
            end
            if best and bestD >= VOID_DIST then
                return best, "farthest-void-aim"
            end
            if best and #pool >= 2 and bestD < VOID_DIST then
                return nil, "ambiguous-near-aim:" .. #pool
            end
            return best, why
        end

        local function findUniqueFireAimAttacker(myHead)
            local firers = recentFirers(FIRE_WINDOW)
            if #firers == 0 then
                return nil, "no-firers"
            end
            return pickBestAttacker(firers, myHead)
        end

        local function findAttacker()
            local myChar = LocalPlayer.Character
            local myHead = myChar and myChar:FindFirstChild("Head")
            local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")

            local tagged = findCreatorAttacker(hum)
            if tagged then
                rememberTrusted(tagged, "creator-tag")
                return tagged, "creator-tag"
            end

            local locked = HealthState.LastTrustedShooter
            if locked
                and locked.Parent == Players
                and not isFriendlyWhitelisted(locked)
                and (os.clock() - HealthState.LastTrustedAt) <= 1.0
            then
                if isVoidLike(locked) or mouseOnUs(locked, myHead) then
                    return locked, "trusted-lock"
                end
            end

            local unique, why = findUniqueFireAimAttacker(myHead)
            if unique then
                rememberTrusted(unique, why)
                return unique, why
            end

            return nil, why or "no-evidence"
        end

        local function resolveAttackerAsync()
            local lastWhy = "pending"
            for i = 1, 8 do
                if not SentryActive then
                    return nil, "disabled"
                end
                local attacker, why = findAttacker()
                lastWhy = why or lastWhy
                if attacker then
                    return attacker, why
                end
                task.wait(0.03)
            end
            return nil, lastWhy
        end

        local function watchCreatorOnInstance(inst)
            if not inst then
                return
            end
            local function consider(child)
                if not child then
                    return
                end
                local isTag = isCreatorTagName(child.Name)
                local isObj = child:IsA("ObjectValue")
                if not isTag and not isObj then
                    if not (child:IsA("StringValue") or child:IsA("IntValue") or child:IsA("NumberValue")) then
                        return
                    end
                    if not isTag then
                        return
                    end
                end
                if not isTag and isObj then
                    local function onLoose()
                        if os.clock() - (HealthState.LastHitAt or 0) > 1.0 then
                            return
                        end
                        local plr = playerFromTag(child)
                        if plr then
                            rememberTrusted(plr, "objectvalue-live")
                        end
                    end
                    CharSubscribe(child.Changed, onLoose)
                    task.defer(onLoose)
                    return
                end
                local function onChanged()
                    local plr = playerFromTag(child)
                    if plr then
                        rememberTrusted(plr, "creator-live")
                    end
                end
                if child:IsA("ValueBase") then
                    CharSubscribe(child.Changed, onChanged)
                end
                task.defer(onChanged)
            end
            for _, child in ipairs(inst:GetChildren()) do
                consider(child)
            end
            CharSubscribe(inst.ChildAdded, consider)
        end

        local function onHealthChanged()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum then
                return
            end

            local current = hum.Health
            local last = HealthState.Last

            if last ~= nil and current < last - 0.5 and current > 0 then
                if os.clock() - HealthState.LastHitAt < 0.25 then
                    HealthState.Last = current
                    return
                end
                HealthState.LastHitAt = os.clock()
                local dmg = last - current

                task.spawn(function()
                    if not SentryActive then
                        return
                    end
                    local attacker, why = resolveAttackerAsync()
                    local gunConfirm = os.clock() - HealthState.LastGunshotAt < 0.9
                    local firers = recentFirers(FIRE_WINDOW)
                    print("[Retaliate] Took " .. dmg .. " dmg"
                        .. (gunConfirm and " [gun-fire confirmed]" or " [no gun signal]")
                        .. ", why=" .. tostring(why)
                        .. ", firers=" .. tostring(#firers)
                        .. ", attacker = " .. tostring(attacker and attacker.Name or "nil"))
                    if attacker then
                        for _ = 1, 6 do
                            if killTarget(attacker) then
                                break
                            end
                            task.wait(0.05)
                        end
                    else
                        print("[Retaliate] no trusted attacker - skip (avoid false positive)")
                    end
                end)
            end

            HealthState.Last = current
        end

        local function hookCharacter()
            HealthState.Last = nil
            local char = LocalPlayer.Character
            if not char then
                return
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                HealthState.Last = hum.Health
                CharSubscribe(hum:GetPropertyChangedSignal("Health"), onHealthChanged)
                watchCreatorOnInstance(hum)
            end
            watchCreatorOnInstance(char)

            local function hookBodyEffects(be)
                if not be then
                    return
                end
                watchCreatorOnInstance(be)
                local gsc = be:FindFirstChild("GunShotChanges")
                if gsc then
                    CharSubscribe(gsc:GetPropertyChangedSignal("Value"), function()
                        HealthState.LastGunshotAt = os.clock()
                    end)
                end
            end

            local be = char:FindFirstChild("BodyEffects")
            if be then
                hookBodyEffects(be)
            else
                CharSubscribe(char.ChildAdded, function(child)
                    if child.Name == "BodyEffects" then
                        hookBodyEffects(child)
                    end
                end)
            end
        end

        SentryResetCharacter()
        hookCharacter()
        SentrySubscribe(LocalPlayer.CharacterAdded, function()
            SentryResetCharacter()
            hookCharacter()
        end)
    end

    _SentryToggle:OnChanged(function(value)
        if value then
            SentryStart()
        else
            SentryStop()
        end
    end)
end
