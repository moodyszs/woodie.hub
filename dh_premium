-- Detect stomped via the game's own "grabbed/stomped" indicators (verified live in Zee):
--   1. Character:FindFirstChild("GRABBING_CONSTRAINT") — direct child, set when grabbed/stomped
--   2. BodyEffects.Grabbed.Value ~= nil — ObjectValue pointing at whoever grabbed them
-- These are exactly what the game checks (MainModule / GunHandler.CanShoot / Framework).
function _AS_isPlayerStomped(player)
    if not player or not player.Character then return false end
    _AS_char = player.Character
    if _AS_char:FindFirstChild("GRABBING_CONSTRAINT") then return true end
    _AS_bodyEffects = _AS_char:FindFirstChild("BodyEffects")
    if _AS_bodyEffects then
        _AS_grabbed = _AS_bodyEffects:FindFirstChild("Grabbed")
        if _AS_grabbed and _AS_grabbed.Value ~= nil then return true end
    end
    return false
end

function _AS_isPlayerStompedOrBroken(player)
    if _AS_isPlayerStomped(player) then return true end
    if not player or not player.Character then return true end
    _AS_char = player.Character
    if not _AS_char:FindFirstChild("HumanoidRootPart") then return true end
    if _AS_char:GetAttribute("Dead") == true then return true end
    return false
end

function _AS_isPlayerKnocked(player)
    if not player or not player.Character then return false end
    _AS_char = player.Character
    if _friday_char_knocked then
        _AS_success, _AS_result = pcall(_friday_char_knocked, _AS_char)
        if _AS_success and _AS_result then return true end
    end
    if _AS_char:GetAttribute("Knocked") == true then return true end
    _AS_bodyEffects = _AS_char:FindFirstChild("BodyEffects")
    if _AS_bodyEffects then
        _AS_ko = _AS_bodyEffects:FindFirstChild("K.O.") or _AS_bodyEffects:FindFirstChild("K.O")
        if _AS_ko and _AS_ko.Value == true then return true end
    end
    return false
end

