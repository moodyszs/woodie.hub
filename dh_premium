        local RS = game:GetService("RunService")
        local pl = Plrs.LocalPlayer
        local RStorage = game:GetService("ReplicatedStorage")

        local armorEnabled = cfg.autoArmor
        local _char, _hum, _root = nil, nil, nil
        local _buying = false
        local _isRespawning = false
        local _lastBuy = 0
        local _shop, _shopCD, _shopPart, _shopAt = nil, nil, nil, 0
        local _shopScanAt = 0
        local _desyncOn = false
        local _desyncCF, _desyncRoot, _desyncPad = nil, nil, nil
        local _desyncHb = nil
        local _failStreak = 0
        local _safeHome = nil
