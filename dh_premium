        return backpack:FindFirstChild("[TacticalShotgun]")
            or (character and character:FindFirstChild("[TacticalShotgun]"))
    end
local function getTarget(player)
        if isFriendlyWhitelisted(player) then
            return nil, false
        end

        local character = player and player.Character
        local humanoid =
            character and character:FindFirstChildOfClass("Humanoid")

        -- If "Skip Knocked Players" (KnockCheck) is off, kill them even when knocked
        local skipKnocked = Toggles.KnockCheck and Toggles.KnockCheck.Value == true

        local bodyEffects =
            character and character:FindFirstChild("BodyEffects")

        local knocked =
            bodyEffects and bodyEffects:FindFirstChild("K.O")

        local valid =
            humanoid
            and humanoid.Health > 0
            and (not skipKnocked or not (knocked and knocked.Value))

        return character, valid
    end

    local function killAll()
        if type(_SD_IsStimBusy) == "function" and _SD_IsStimBusy() then
            return false
        end

        local character = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")

        if character == nil or backpack == nil then
            return false
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local tool = getTacticalShotgun(character, backpack)
        local handle = tool and tool:FindFirstChild("Handle")
        local ammo = tool and tool:FindFirstChild("Ammo")

        if KillAllRemote == nil
            or humanoid == nil
            or tool == nil
            or handle == nil
            or ammo == nil
        then
            return false
        end
        if not usableAmmo(tool, ammo) then
            _SD_BusyFor(2)
            return false
        end

        local pellets = {}

        for _, player in ipairs(Players:GetPlayers()) do
            -- Skip local player, players not allowed by the Whitelist (when enabled),
            -- and any player on the Blacklist (respects Auto-Block Friends)
            if player ~= LocalPlayer
                and (type(_WL_Allows) ~= "function" or _WL_Allows(player))
                and not (type(_BL_IsBlocked) == "function" and _BL_IsBlocked(player)) then
                local targetCharacter, valid = getTarget(player)
                local head =
                    targetCharacter and targetCharacter:FindFirstChild("Head")

                if valid and head then
                    local position = head.Position

                    for _ = 1, 20 do
                        pellets[#pellets + 1] = {
                            AimPosition = position,
                            Result1 = position,
                            Result2 = head,
                            Result3 = Vector3.yAxis
                        }
                    end
                end
            end
        end

        if #pellets == 0 then
            return false
        end

        local rangeObject = tool:FindFirstChild("Range")
        local damageObject = tool:FindFirstChild("Damage")

        local range = rangeObject and rangeObject.Value or 200
        local damage = damageObject and damageObject.Value or 50

        tool.Enabled = true

        if tool.Parent ~= character then
            tool.Parent = character
        end

        for _ = 1, 8 do
            KillAllRemote:FireServer(
                "ShootGun",
                handle,
                handle.Position,
                pellets,
                nil,
                nil,
                nil,
                range,
                damage
            )
        end

        if tool.Parent then
            tool.Parent = backpack
        end

        return true
    end

