        if KillAllRemote == nil or humanoid == nil or tool == nil or handle == nil or ammo == nil then return false end
        if not usableAmmo(tool, ammo) then _SD_BusyFor(2); return false end
        local targetCharacter, valid = getTarget(player)
        local head = targetCharacter and targetCharacter:FindFirstChild("Head")
        if not valid or not head then return false end
        local position = head.Position
        local pellets = {}
        for _ = 1, 20 do
            pellets[#pellets + 1] = { AimPosition = position, Result1 = position, Result2 = head, Result3 = Vector3.yAxis }
        end
        local rangeObject = tool:FindFirstChild("Range")
        local damageObject = tool:FindFirstChild("Damage")
        local range = rangeObject and rangeObject.Value or 200
        local damage = damageObject and damageObject.Value or 50
        tool.Enabled = true
        if tool.Parent ~= character then tool.Parent = character end
        KillAllRemote:FireServer("ShootGun", handle, handle.Position, pellets, nil, nil, nil, range, damage)
        if tool.Parent then tool.Parent = backpack end
        return true
    end
