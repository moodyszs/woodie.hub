                end
            end
            for _, child in ipairs(root:GetChildren()) do
                consider(child)
            end
            for _, desc in ipairs(root:GetDescendants()) do
                consider(desc)
            end
        end

        local function findCreatorAttacker(hum)
            local char = LocalPlayer.Character
            if not hum then
                hum = char and char:FindFirstChildOfClass("Humanoid")
            end
            if not hum then
                return nil
            end
            local list, seen = {}, {}
            collectCreatorPlayers(hum, list, seen)
            if char then
                collectCreatorPlayers(char, list, seen)
                local be = char:FindFirstChild("BodyEffects")
                if be then
                    collectCreatorPlayers(be, list, seen)
                end
            end
            if #list == 0 then
                return nil
            end
            if #list == 1 then
                return list[1]
            end
            local locked = HealthState.LastTrustedShooter
            if locked and seen[locked] then
                return locked
            end
            return nil
        end

        local function recordFire(player, why)
            if not player or player == LocalPlayer then
                return
            end
            FireTracker.FiredAt[player] = os.clock()
            FireTracker.FireWhy = FireTracker.FireWhy or {}
            FireTracker.FireWhy[player] = why or "fire"
        end

        local function findAmmoValue(tool)
            if not tool then
                return nil
            end
            local ammo = tool:FindFirstChild("Ammo")
                or tool:FindFirstChild("ammo")
                or tool:FindFirstChild("AMMO")
            if ammo and ammo:IsA("ValueBase") then
                return ammo
            end
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("ValueBase") and string.lower(d.Name) == "ammo" then
                    return d
                end
            end
            return nil
        end

        local function allToolsWithAmmo(player)
            local list = {}
            local function add(container)
                if not container then
                    return
                end
                for _, t in ipairs(container:GetChildren()) do
                    if t:IsA("Tool") and findAmmoValue(t) then
                        list[#list + 1] = t
                    end
                end
            end
            add(player.Character)
            add(player:FindFirstChild("Backpack"))
            return list
        end

        local function watchGunFiringFlag(be, player)
            if not be or be:GetAttribute("__sentry_gf_watch") then
                return
            end
            be:SetAttribute("__sentry_gf_watch", true)
            for _, name in ipairs({ "GunFiring", "Shooting", "Attacking", "GunFire" }) do
                local flag = be:FindFirstChild(name)
                if flag and flag:IsA("ValueBase") and not flag:GetAttribute("__sentry_gf") then
                    flag:SetAttribute("__sentry_gf", true)
                    SentrySubscribe(flag.Changed, function()
                        local v = flag.Value
                        if v == true or v == 1 then
                            local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                            local mp = FireTracker.Mouse[player]
                            local aimed = myHead and mp and typeof(mp) == "Vector3"
                                and (mp - myHead.Position).Magnitude <= 45
                            local far = true
                            do
                                local me = LocalPlayer.Character
                                    and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                        or LocalPlayer.Character:FindFirstChild("Head"))
                                local them = player.Character
                                    and (player.Character:FindFirstChild("HumanoidRootPart")
                                        or player.Character:FindFirstChild("Head"))
                                if me and them then
                                    far = (them.Position - me.Position).Magnitude >= 120
                                elseif player.Character then
                                    far = false
                                end
                            end
                            if aimed or far or not player.Character then
                                recordFire(player, name)
                            end
                        end
                    end)
                end
            end
        end

        local function scanPlayers()
            local now = os.clock()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local char = p.Character
                    if char then
                        local be = char:FindFirstChild("BodyEffects")
                        if be then
                            local mp = be:FindFirstChild("MousePos")
                            if mp then
                                local ok, v = pcall(function()
                                    return mp.Value
                                end)
                                if ok and typeof(v) == "Vector3" then
                                    FireTracker.Mouse[p] = v
                                end
                            end
                            watchGunFiringFlag(be, p)
                        end
                    end
                    for _, tool in ipairs(allToolsWithAmmo(p)) do
                        local ammo = findAmmoValue(tool)
                        local watch = GunWatch[tool]
                        if ammo then
                            local val = tonumber(ammo.Value) or 0
                            if watch then
                                if val < watch.ammo then
                                    recordFire(p, "ammo")
                                end
                                watch.ammo = val
                            else
                                GunWatch[tool] = { player = p, ammo = val }
                            end
                        elseif watch then
                            GunWatch[tool] = nil
                        end
                    end
                end
            end
            for plr, at in pairs(FireTracker.FiredAt) do
                if now - at > 1.5 then
                    FireTracker.FiredAt[plr] = nil
                end
            end
        end

        SentrySubscribe(RunService.Heartbeat, scanPlayers)

        local function attackerFromBulletObj(obj)
            if not obj then
                return nil
            end
            local owner = obj:GetAttribute("OwnerCharacter")
                or obj:GetAttribute("Owner")
                or obj:GetAttribute("owner")
                or obj:GetAttribute("Creator")
                or obj:GetAttribute("Shooter")
                or obj:GetAttribute("GunOwner")
            local plr = playerFromValue(owner)
            if plr then
                return plr
            end
            for _, n in ipairs({ "Owner", "Creator", "Shooter", "OwnerCharacter" }) do
                local v = obj:FindFirstChild(n)
                if v then
                    plr = playerFromTag(v) or playerFromValue(v.Value)
                    if plr then
                        return plr
                    end
                end
            end
            return nil
        end

        local function watchBulletFolder(folder)
            if not folder or folder:GetAttribute("__sentry_bullets") then
                return
            end
            folder:SetAttribute("__sentry_bullets", true)
            local function onObj(obj)
                task.defer(function()
                    local plr = attackerFromBulletObj(obj)
                    if plr and plr ~= LocalPlayer and not isFriendlyWhitelisted(plr) then
                        recordFire(plr, "bullet")
                    end
                end)
            end
            SentrySubscribe(folder.DescendantAdded, onObj)
            SentrySubscribe(folder.ChildAdded, onObj)
        end

        task.spawn(function()
            local function scanRoots()
                for _, name in ipairs({ "Ignored", "Debris", "Effects", "Projectiles" }) do
                    local root = workspace:FindFirstChild(name)
                    if root then
                        watchBulletFolder(root)
                        local br = root:FindFirstChild("BULLET_RAYS")
                        if br then
