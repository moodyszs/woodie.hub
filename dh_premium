do -- combat/stim busy coordination (scoped to free registers)
    _SD_Busy = 0
    _SD_BusyDeadline = 0
    function _SD_BusyFor(seconds)
        seconds = seconds or 2
        -- Throttle: callers like kill-all retry every frame while ammo refills;
        -- without this, busy tokens pile up for minutes and permanently lock
        -- out the stim/armor controllers (auto stim never buys/uses).
        local now = tick()
        if (_SD_Busy or 0) > 0 and _SD_BusyDeadline > now then
            return
        end
        _SD_Busy = (_SD_Busy or 0) + 1
        _SD_BusyDeadline = now + seconds
        task.delay(seconds, function()
            _SD_Busy = math.max(0, (_SD_Busy or 0) - 1)
            if _SD_Busy == 0 then
                _SD_BusyDeadline = 0
            end
        end)
    end
    function _SD_IsCombatBusy()
        return (_SD_Busy or 0) > 0
    end
end

