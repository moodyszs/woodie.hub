        local function buyStims(force)
            if _SD_IsCombatBusy() then
                return false
            end
            if (not stimEnabled and not force) or _buying or _isRespawning or isDead() then
                return false
            end
            local now = tick()
            if now < _buyLockUntil then
                return false
            end
            if _failStreak >= 4 and now - _lastBuy < 2 then
                return false
            end
            if now - _lastBuy < (cfg.stimBuyCooldown or 0.55) then
                return false
            end

            local before = countStims()
            local need = stockTarget()
            local pair = cfg.pairBuy
            if before >= need then
                _failStreak = 0
                return false
            end

            if not force and inCombat() and before > 0 then
                return false
            end

            refreshChar()
            local shop, cd, part = findStimShop(_failStreak >= 2)
            if not cd or not part or not _root then
                _noShop = false
                findStimShop(true)
                shop, cd, part = findStimShop(false)
                if not cd or not part or not _root then
                    _buyLockUntil = tick() + 1.5
                    return false
                end
            end

            _buying, _lastBuy = true, now
            _abortBuy = false
            _buyDeadline = now + (cfg.buyMaxTime or 2.4) * (pair and 1 or 0.65)
            local shopCF = part.CFrame * CFrame.new(0, 3, 0)
            refreshChar()
            if not _root or not _root.Parent then
                _buying = false
                _buyDeadline = 0
                return false
            end
            local home = nil
            local savedVel = nil
            local got = before
            local aborted = false
            local retries = math.clamp(cfg.buyRetries or 2, 1, 3)
            local mainDSWasActive = false
            local voidWasActive = false

            local okBuy = pcall(function()
                if not _root or not _root.Parent or shouldAbortBuy() then
                    aborted = true
                    return
                end

                pcall(function() cd.MaxActivationDistance = 9e9 end)

                -- Pause script-level desync/void-hide while buying (restore after)
                if _DS and _DS.active then
                    mainDSWasActive = true
                    pcall(function() _DS._stop() end)
                end
                if _118 then
                    voidWasActive = true
                    if _121 then
                        pcall(function() _121:Disconnect() end)
                        _121 = nil
                    end
