                if shouldAbortBuy() then
                    aborted = true
                    return
                end

                local function attemptBuy1()
                    if shouldAbortBuy() then return countStims() end
                    stayAtPad(shopCF, 0.05)
                    clickBurst(cd, shopCF, pair and 6 or 5)
                    return waitStimCount(before + 1, pair and 0.75 or 0.65)
                end

                if not pair or before < 1 then
                    for _ = 1, retries do
                        if shouldAbortBuy() then
                            aborted = true
                            break
                        end
                        got = attemptBuy1()
                        if got > before then break end
                        task.wait(0.05)
                    end
                    if got <= before and cfg.ghostTP and not shouldAbortBuy() and not inCombat() then
                        setPadTarget(shopCF)
                        stayAtPad(shopCF, 0.06)
                        got = attemptBuy1()
                        if cfg.ghostTP and not shouldAbortBuy() then
                            startDesync(home, shopCF)
                        end
                    end
                    if shouldAbortBuy() then
                        aborted = true
                        return
                    end
                    if got <= before then
                        return
                    end
                else
                    got = before
                end

                if not pair then
                    return
                end

                if shouldAbortBuy() then
                    aborted = true
                    return
                end

                _stimCount, _stimTool = -1, nil
                local held = nil
                for _ = 1, 5 do
                    if shouldAbortBuy() then
                        aborted = true
                        return
                    end
                    held = findStimTool()
                    if held then
                        pcall(function() _hum:EquipTool(held) end)
                        break
                    end
                    task.wait(0.05)
                end
                if not held then
                    return
                end

                local target2 = 2
                for _ = 1, retries do
                    if got >= target2 or shouldAbortBuy() then
                        if shouldAbortBuy() then
                            aborted = true
                        end
                        break
                    end
                    setPadTarget(shopCF)
                    if not findStimTool() then
                        held = findStimTool()
                        if not held then
                            return
                        end
                    end
                    setCrouch(true)
                    task.wait(0.12)
                    for _ = 1, 3 do
                        if shouldAbortBuy() then break end
                        pcall(function()
                            VIM:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, nil)
                        end)
                        setPadTarget(shopCF)
                        fireClick(cd)
                        task.wait(0.03)
                    end
                    clickBurst(cd, shopCF, 4)
                    got = waitStimCount(target2, 0.7)
                    if got >= target2 then
